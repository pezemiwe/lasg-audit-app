generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  STATE_AUDITOR_GENERAL
  AUDIT_SUPERVISOR
  AUDIT_LEAD
  TEAM_AUDITOR
  HEAD_OF_LOCAL_GOVERNMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CouncilType {
  LGA
  LCDA
}

enum AuditType {
  FINANCIAL
  PERFORMANCE
  COMPLIANCE
  COMBINED
}

enum MandateStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
}

enum MandateTargetMode {
  ALL_COUNCILS
  SELECTED_COUNCILS
}

enum MandateCouncilStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum AuditStatus {
  PENDING
  PRE_AUDIT
  PLANNING
  FIELDWORK
  REVIEW
  REPORTING
  POST_AUDIT
  COMPLETED
}

enum DocumentRequirementStatus {
  ACTIVE
  INACTIVE
}

enum AuditDocumentStatus {
  NOT_UPLOADED
  UPLOADED
  REVIEWED
  APPROVED
  REJECTED
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  phone          String?
  role           Role
  status         UserStatus @default(ACTIVE)
  passwordHash   String
  zoneId         String?
  councilId      String?
  specialisations String[]  @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  zone           Zone?      @relation("UserZone", fields: [zoneId], references: [id], onDelete: SetNull)
  council        Council?   @relation("UserCouncil", fields: [councilId], references: [id], onDelete: SetNull)
  supervisedZone Zone?      @relation("ZoneSupervisor")
  activityLogs      ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  createdMandates    Mandate[] @relation("MandateCreatedBy")
  acceptedMandates   MandateCouncil[] @relation("MandateAcceptedBy")
  rejectedMandates   MandateCouncil[] @relation("MandateRejectedBy")
  ledAuditEngagements AuditEngagement[] @relation("AuditEngagementLead")
  uploadedAuditDocuments AuditDocument[] @relation("AuditDocumentUploadedBy")
  reviewedAuditDocuments AuditDocument[] @relation("AuditDocumentReviewedBy")

  @@index([role])
  @@index([status])
  @@index([zoneId])
  @@index([councilId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Zone {
  id           String    @id @default(cuid())
  name         String    @unique
  capital      String
  supervisorId String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supervisor   User?     @relation("ZoneSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  councils     Council[]
  users        User[]    @relation("UserZone")
  auditEngagements AuditEngagement[]
}

model Council {
  id           String      @id @default(cuid())
  name         String      @unique
  type         CouncilType
  zoneId       String
  parentLgaId  String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  zone         Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  parentLga    Council?    @relation("CouncilParent", fields: [parentLgaId], references: [id], onDelete: SetNull)
  lcdas        Council[]   @relation("CouncilParent")
  users        User[]      @relation("UserCouncil")
  mandateTargets MandateCouncil[]
  auditEngagements AuditEngagement[]

  @@index([zoneId])
  @@index([type])
  @@index([parentLgaId])
}

model Mandate {
  id            String            @id @default(cuid())
  title         String
  year          Int
  description   String
  startDate     DateTime
  endDate       DateTime
  scope         String
  objectives    String[]          @default([])
  auditTypes    AuditType[]       @default([])
  signatureUrl  String
  targetMode    MandateTargetMode @default(ALL_COUNCILS)
  status        MandateStatus     @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy     User              @relation("MandateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  councils      MandateCouncil[]
  audits        Audit[]

  @@index([year])
  @@index([status])
  @@index([targetMode])
  @@index([createdById])
}

model MandateCouncil {
  id                          String                @id @default(cuid())
  mandateId                   String
  councilId                   String
  status                      MandateCouncilStatus  @default(PENDING)
  acceptedById                String?
  acceptedAt                  DateTime?
  rejectedById                String?
  rejectedAt                  DateTime?
  rejectionReason             String?
  documentPortalUnlockedAt    DateTime?
  questionnaireUnlockedAt     DateTime?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  mandate                    Mandate                @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  council                    Council                @relation(fields: [councilId], references: [id], onDelete: Restrict)
  acceptedBy                 User?                  @relation("MandateAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  rejectedBy                 User?                  @relation("MandateRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  auditEngagement            AuditEngagement?

  @@unique([mandateId, councilId])
  @@index([councilId])
  @@index([status])
  @@index([acceptedById])
  @@index([rejectedById])
}

model Audit {
  id           String            @id @default(cuid())
  mandateId    String            @unique
  title        String
  year         Int
  auditTypes   AuditType[]        @default([])
  status       AuditStatus        @default(PENDING)
  progress     Int                @default(0)
  startDate    DateTime?
  endDate      DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  mandate      Mandate            @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  engagements  AuditEngagement[]

  @@index([status])
  @@index([year])
}

model AuditEngagement {
  id                 String          @id @default(cuid())
  auditId            String
  mandateCouncilId   String          @unique
  councilId          String
  zoneId             String
  status             AuditStatus     @default(PENDING)
  progress           Int             @default(0)
  leadId             String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  audit              Audit           @relation(fields: [auditId], references: [id], onDelete: Cascade)
  mandateCouncil     MandateCouncil  @relation(fields: [mandateCouncilId], references: [id], onDelete: Cascade)
  council            Council         @relation(fields: [councilId], references: [id], onDelete: Restrict)
  zone               Zone            @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  lead               User?           @relation("AuditEngagementLead", fields: [leadId], references: [id], onDelete: SetNull)
  documents          AuditDocument[]

  @@index([auditId])
  @@index([councilId])
  @@index([zoneId])
  @@index([status])
  @@index([leadId])
}

model DocumentRequirement {
  id             String                    @id @default(cuid())
  name           String                    @unique
  description    String?
  requiredFormat String
  category       String?
  sortOrder      Int                       @default(0)
  status         DocumentRequirementStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  auditDocuments AuditDocument[]

  @@index([status])
  @@index([sortOrder])
}

model AuditDocument {
  id                    String              @id @default(cuid())
  auditEngagementId     String
  documentRequirementId String?
  name                  String
  description           String?
  requiredFormat        String
  category              String?
  sortOrder             Int                 @default(0)
  status                AuditDocumentStatus @default(NOT_UPLOADED)
  fileUrl               String?
  originalFileName      String?
  mimeType              String?
  fileSize              Int?
  uploadedById          String?
  uploadedAt            DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  auditEngagement       AuditEngagement      @relation(fields: [auditEngagementId], references: [id], onDelete: Cascade)
  documentRequirement   DocumentRequirement? @relation(fields: [documentRequirementId], references: [id], onDelete: SetNull)
  uploadedBy            User?                @relation("AuditDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reviewedBy            User?                @relation("AuditDocumentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([auditEngagementId, documentRequirementId])
  @@index([auditEngagementId])
  @@index([documentRequirementId])
  @@index([status])
  @@index([uploadedById])
  @@index([reviewedById])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
