generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  STATE_AUDITOR_GENERAL
  AUDIT_SUPERVISOR
  AUDIT_LEAD
  TEAM_AUDITOR
  HEAD_OF_LOCAL_GOVERNMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CouncilType {
  LGA
  LCDA
}

enum AuditType {
  FINANCIAL
  PERFORMANCE
  COMPLIANCE
  COMBINED
}

enum MandateStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
}

enum MandateTargetMode {
  ALL_COUNCILS
  SELECTED_COUNCILS
}

enum MandateCouncilStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  phone          String?
  role           Role
  status         UserStatus @default(ACTIVE)
  passwordHash   String
  zoneId         String?
  councilId      String?
  specialisations String[]  @default([])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  zone           Zone?      @relation("UserZone", fields: [zoneId], references: [id], onDelete: SetNull)
  council        Council?   @relation("UserCouncil", fields: [councilId], references: [id], onDelete: SetNull)
  supervisedZone Zone?      @relation("ZoneSupervisor")
  activityLogs      ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  createdMandates    Mandate[] @relation("MandateCreatedBy")
  acceptedMandates   MandateCouncil[] @relation("MandateAcceptedBy")

  @@index([role])
  @@index([status])
  @@index([zoneId])
  @@index([councilId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Zone {
  id           String    @id @default(cuid())
  name         String    @unique
  capital      String
  supervisorId String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supervisor   User?     @relation("ZoneSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  councils     Council[]
  users        User[]    @relation("UserZone")
}

model Council {
  id           String      @id @default(cuid())
  name         String      @unique
  type         CouncilType
  zoneId       String
  parentLgaId  String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  zone         Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  parentLga    Council?    @relation("CouncilParent", fields: [parentLgaId], references: [id], onDelete: SetNull)
  lcdas        Council[]   @relation("CouncilParent")
  users        User[]      @relation("UserCouncil")
  mandateTargets MandateCouncil[]

  @@index([zoneId])
  @@index([type])
  @@index([parentLgaId])
}

model Mandate {
  id            String            @id @default(cuid())
  title         String
  year          Int
  description   String
  startDate     DateTime
  endDate       DateTime
  scope         String
  objectives    String[]          @default([])
  auditTypes    AuditType[]       @default([])
  signatureUrl  String
  targetMode    MandateTargetMode @default(ALL_COUNCILS)
  status        MandateStatus     @default(DRAFT)
  createdById   String
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy     User              @relation("MandateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  councils      MandateCouncil[]

  @@index([year])
  @@index([status])
  @@index([targetMode])
  @@index([createdById])
}

model MandateCouncil {
  id                          String                @id @default(cuid())
  mandateId                   String
  councilId                   String
  status                      MandateCouncilStatus  @default(PENDING_ACCEPTANCE)
  acceptedById                String?
  acceptedAt                  DateTime?
  documentPortalUnlockedAt    DateTime?
  questionnaireUnlockedAt     DateTime?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  mandate                    Mandate                @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  council                    Council                @relation(fields: [councilId], references: [id], onDelete: Restrict)
  acceptedBy                 User?                  @relation("MandateAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([mandateId, councilId])
  @@index([councilId])
  @@index([status])
  @@index([acceptedById])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
